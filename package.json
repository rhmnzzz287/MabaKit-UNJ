{
  "name": "mabakit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json && tsc -p backend/tsconfig.json",
    "typecheck:worker": "tsc -p backend/tsconfig.json",
    "dev:worker": "npm run build && cd backend && wrangler dev",
    "db:migrate:local": "cd backend && wrangler d1 migrations apply mabakit-demo --local",
    "db:seed:local": "cd backend && wrangler d1 execute mabakit-demo --local --file=db/seed.sql"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
